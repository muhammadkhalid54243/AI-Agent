# ─── Python ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
wheels/
*.so

# ─── Virtual environments ─────────────────────────────────
.venv/
venv/
env/

# ─── Secrets / environment ────────────────────────────────
.env
.env.*
!.env.example

# ─── Test / tooling caches ────────────────────────────────
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ─── Agent runtime notes (framework.context.notes) ────────
.agent_memory/

# ─── Editors / OS ─────────────────────────────────────────
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ─── Claude Code local settings ───────────────────────────
.claude/settings.local.json

# ─── Documents: ignore all corpora/exports; KEEP the small eval gold sets ──
docs/*
!docs/gold/

# ─── RAG ingest cache (text exports, indexes, embedding cache) ─────────────
.rag_cache/

# ─── Observability data (Prometheus TSDB, Grafana DB, Jaeger Badger) ───────
# Kept in-project so it survives restarts, but never committed. Keep the dir via .gitkeep.
/observability/data/
!/observability/data/.gitkeep

# ─── Personal learning-system files (not part of the framework) ──
CLAUDE.md
PROGRESS.md
ROADMAP.md
