# Copy this file to `.env` and fill in at least one provider key.
# `.env` is git-ignored; never commit real keys.

# Active model as "provider:model" (optional; defaults to groq:llama-3.3-70b-versatile)
FRAMEWORK_MODEL=groq:llama-3.3-70b-versatile

# Provider API keys — set at least one that matches FRAMEWORK_MODEL
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Required only for RAG embeddings (framework.rag)
GOOGLE_API_KEY=

# Server bind (optional)
HOST=127.0.0.1
PORT=8000
