# Copy this file to `.env` and fill in at least one provider key.
# `.env` is git-ignored; never commit real keys.

# Active model as "provider:model" (optional; defaults to groq:openai/gpt-oss-120b)
FRAMEWORK_MODEL=groq:openai/gpt-oss-120b

# Provider API keys — set at least one that matches FRAMEWORK_MODEL
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Required only for RAG embeddings (framework.rag)
GOOGLE_API_KEY=

# Server bind (optional)
HOST=127.0.0.1
PORT=8000

# --- Response tracing (OpenTelemetry) — OFF by default -----------------------------
# Turn on per-request tracing of the RAG pipeline (condense→retrieve→generate→parse→verify).
TRACE_BACKEND=none                      # none (default) | otel
# With no endpoint, otel prints spans to the console. For a UI, run a self-hosted Jaeger:
#   docker run -d --name jaeger -e COLLECTOR_OTLP_ENABLED=true -p 16686:16686 -p 4318:4318 \
#       jaegertracing/all-in-one:latest
# then set the endpoint and view traces at http://localhost:16686
OTEL_EXPORTER_OTLP_ENDPOINT=            # e.g. http://localhost:4318  (OTLP/HTTP; Jaeger)
OTEL_SERVICE_NAME=hrcp-rag
# Sensitive corpus: span TEXT payloads (question/answer/quote) are redacted unless this is 1.
TRACE_PAYLOADS=0

# --- Metrics dashboard (Prometheus + Grafana) — OFF by default ---------------------
# Aggregate metrics over time (LLM calls, tokens, per-stage latency, abstain rate, confidence).
# Counts/latency only — no text payloads. Independent of tracing; enable either or both.
#   docker compose -f docker-compose.observability.yml up -d   # Jaeger + Prometheus + Grafana
# Grafana: http://localhost:3000  -> dashboard "HRCP RAG"
METRICS_BACKEND=none                    # none (default) | prometheus
METRICS_PORT=9464                       # Prometheus scrapes this (bound to 0.0.0.0)
